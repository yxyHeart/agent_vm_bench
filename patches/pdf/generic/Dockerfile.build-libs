FROM pdf-build:base
RUN sed -i "s|ports.ubuntu.com/ubuntu-ports|repo.huaweicloud.com/ubuntu-ports|g" /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true; apt-get update && apt-get install -y --no-install-recommends libtiff-dev liblcms2-dev pkg-config && rm -rf /var/lib/apt/lists/*

COPY poppler-24.02.0.tar.xz zlib-ng-2.2.4.tar.gz /src/

# zlib-ng in zlib-compat mode: drop-in libz.so.1 replacement
RUN cd /src && tar xf zlib-ng-2.2.4.tar.gz && cd zlib-ng-2.2.4 && \
    sed -i '/add_subdirectory(test)/d' CMakeLists.txt && mkdir build && cd build && cmake -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS="-O3 -mcpu=tsv110 -fPIC" -DZLIB_COMPAT=ON -DWITH_OPTIM=ON \
        -DCMAKE_INSTALL_PREFIX=/out/zlib-ng -DBUILD_TESTING=OFF \
        .. > /tmp/zlibng-cmake.log 2>&1 && ninja -j"$(nproc)" install > /tmp/zlibng-make.log 2>&1 && \
    find /out/zlib-ng -name "libz.so*"

# poppler with Kunpeng-tuned flags, utils only
RUN cd /src && tar xf poppler-24.02.0.tar.xz && cd poppler-24.02.0 && \
    mkdir build && cd build && cmake -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS="-O3 -mcpu=tsv110" -DCMAKE_CXX_FLAGS="-O3 -mcpu=tsv110 -flto=4" \
        -DCMAKE_EXE_LINKER_FLAGS="-flto=4" \
        -DENABLE_QT5=OFF -DENABLE_QT6=OFF -DENABLE_CPP=OFF -DENABLE_GLIB=OFF -DENABLE_GO=OFF \
        -DENABLE_BOOST=OFF -DENABLE_LIBCURL=OFF -DENABLE_NSS3=OFF -DENABLE_GPGME=OFF \
        -DENABLE_UTILS=ON -DBUILD_GTK_TESTS=OFF -DBUILD_QT5_TESTS=OFF -DBUILD_QT6_TESTS=OFF \
        -DBUILD_CPP_TESTS=OFF -DBUILD_MANUAL_TESTS=OFF -DENABLE_CMS=none -DENABLE_LIBOPENJPEG=none \
        -DCMAKE_INSTALL_PREFIX=/out/poppler \
        .. > /tmp/poppler-cmake.log 2>&1 && ninja -j"$(nproc)" install > /tmp/poppler-make.log 2>&1 && \
    /out/poppler/bin/pdftoppm -v 2>&1 | head -1 || { echo ===CMAKELOG===; tail -20 /tmp/poppler-cmake.log; echo ===MAKELOG===; tail -20 /tmp/poppler-make.log; exit 1; }
