FROM pdf-build:native-libs AS srcs
FROM pdf-build:base
COPY --from=srcs /src/zlib-ng-2.2.4.tar.gz /srcsrc/zlib-ng-2.2.4.tar.gz
COPY compare256_neon.c.patched /patch/compare256_neon.c
RUN sed -i "s|ports.ubuntu.com/ubuntu-ports|repo.huaweicloud.com/ubuntu-ports|g" /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true; apt-get update -qq && apt-get install -y -qq --no-install-recommends cmake ninja-build >/dev/null; mkdir -p /work/z && cd /work/z && tar xf /srcsrc/zlib-ng-2.2.4.tar.gz && sed -i "/add_subdirectory(test)/d" zlib-ng-2.2.4/CMakeLists.txt && cd zlib-ng-2.2.4 && mkdir b1 && cd b1 && cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -DZLIB_COMPAT=ON -DWITH_OPTIM=ON -DBUILD_TESTING=OFF -DCMAKE_C_FLAGS="-O3 -march=armv8.2-a+sve" -DCMAKE_INSTALL_PREFIX=/out/zng-base .. > /tmp/c1.log 2>&1 && ninja -j16 install > /tmp/n1.log 2>&1 && echo B1-OK && cd .. && cp /patch/compare256_neon.c arch/arm/compare256_neon.c && mkdir b2 && cd b2 && cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -DZLIB_COMPAT=ON -DWITH_OPTIM=ON -DBUILD_TESTING=OFF -DCMAKE_C_FLAGS="-O3 -march=armv8.2-a+sve" -DCMAKE_INSTALL_PREFIX=/out/zng-sve .. > /tmp/c2.log 2>&1 && ninja -j16 install > /tmp/n2.log 2>&1 && echo B2-OK || { echo ===C2===; tail -6 /tmp/c2.log; echo ===N2===; grep -iE -A2 "error|note: previous" /tmp/n2.log | head -24; exit 1; } && ls -la /out/zng-base/lib/libz.so.1 /out/zng-sve/lib/libz.so.1
