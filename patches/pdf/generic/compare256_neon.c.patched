#include "zbuild.h"
#include "zmemory.h"
#include "deflate.h"
#include "fallback_builtins.h"

#if defined(ARM_NEON) && defined(HAVE_BUILTIN_CTZLL)
#include "neon_intrins.h"

static inline uint32_t compare256_neon_static(const uint8_t *src0, const uint8_t *src1) {
    uint32_t len = 0;

    do {
        uint8x16_t a, b, cmp;
        uint64_t lane;

        a = vld1q_u8(src0);
        b = vld1q_u8(src1);

        cmp = veorq_u8(a, b);

        lane = vgetq_lane_u64(vreinterpretq_u64_u8(cmp), 0);
        if (lane) {
            uint32_t match_byte = (uint32_t)__builtin_ctzll(lane) / 8;
            return len + match_byte;
        }
        len += 8;
        lane = vgetq_lane_u64(vreinterpretq_u64_u8(cmp), 1);
        if (lane) {
            uint32_t match_byte = (uint32_t)__builtin_ctzll(lane) / 8;
            return len + match_byte;
        }
        len += 8;

        src0 += 16, src1 += 16;
    } while (len < 256);

    return 256;
}

/* PATCH: SVE compare256 (validated vs NEON on 200k random cases) */
#include <sys/auxv.h>
#ifndef HWCAP_SVE
#define HWCAP_SVE (1 << 22)
#endif

static inline int zng_have_sve(void) {
    static int cached = -1;
    if (cached < 0)
        cached = !!(getauxval(AT_HWCAP) & HWCAP_SVE);
    return cached;
}

#pragma GCC push_options
#pragma GCC target("arch=armv8.2-a+sve")
#include <arm_sve.h>
static uint32_t compare256_sve_static(const uint8_t *src0, const uint8_t *src1) {
    uint32_t len = 0;
    svbool_t pg = svptrue_b8();
    do {
        svuint8_t a = svld1_u8(pg, src0);
        svuint8_t b = svld1_u8(pg, src1);
        svuint8_t cmp = sveor_u8_x(pg, a, b);
        svbool_t nz = svcmpne_n_u8(pg, cmp, 0);
        if (svptest_any(pg, nz)) {
            svbool_t before = svbrkb_b_z(pg, nz);
            uint64_t idx = svcntp_b8(pg, before);
            return len + (uint32_t)idx;
        }
        len += (uint32_t)svcntb();
        src0 += svcntb(), src1 += svcntb();
    } while (len < 256);
    return 256;
}
#pragma GCC pop_options

static inline uint32_t compare256_dispatch(const uint8_t *src0, const uint8_t *src1) {
    if (zng_have_sve())
        return compare256_sve_static(src0, src1);
    return compare256_neon_static(src0, src1);
}

Z_INTERNAL uint32_t compare256_neon(const uint8_t *src0, const uint8_t *src1) {
    return compare256_dispatch(src0, src1);
}

#define LONGEST_MATCH       longest_match_neon
#define COMPARE256          compare256_dispatch

#include "match_tpl.h"

#define LONGEST_MATCH_SLOW
#define LONGEST_MATCH       longest_match_slow_neon
#define COMPARE256          compare256_dispatch

#include "match_tpl.h"

#endif
