FROM ubuntu-document-bench:24.04-linuxarm64
RUN sed -i "s|ports.ubuntu.com/ubuntu-ports|repo.huaweicloud.com/ubuntu-ports|g" /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true; apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build python3-dev python3-pip linux-tools-common linux-tools-generic pkg-config libfreetype-dev libfontconfig-dev libpng-dev libjpeg-dev zlib1g-dev libbz2-dev liblzma-dev libffi-dev uuid-dev libsqlite3-dev libreadline-dev libncurses-dev libgdbm-dev tk-dev && pip3 install --break-system-packages -i https://repo.huaweicloud.com/repository/pypi/simple cython && rm -rf /var/lib/apt/lists/*
